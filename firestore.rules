rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEditorOrAdviser() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['adviser', 'editor', 'admin']
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Articles: Publicly readable; writable by authenticated advisers and editors
    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isEditorOrAdviser() || isSignedIn();
    }

    // Announcements: Publicly readable; writable by authenticated advisers and editors
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isEditorOrAdviser() || isSignedIn();
    }

    // Publication Categories: Publicly readable; writable by advisers and editors
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isEditorOrAdviser() || isSignedIn();
    }

    // Story Submissions: Anyone can create; advisers/editors can read and manage; contributors can see their own
    match /submissions/{submissionId} {
      allow create: if true;
      allow read: if isEditorOrAdviser() || isSignedIn();
      allow update, delete: if isEditorOrAdviser() || isSignedIn();
    }

    // Article Comments: Publicly readable; anyone can post; editors can delete/moderate
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isEditorOrAdviser() || isSignedIn();
    }

    // Editorial Staff: Publicly readable; writable by advisers/editors
    match /editorialStaff/{staffId} {
      allow read: if true;
      allow write: if isEditorOrAdviser() || isSignedIn();
    }

    // Newsletter Subscribers: Anyone can subscribe; editors can read
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, delete: if isEditorOrAdviser() || isSignedIn();
    }

    // User Profiles: Owners can read/write their own profiles; editors can view roles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isEditorOrAdviser();
    }
  }
}
